# RemitSave Africa - Environment Configuration

# Stellar & Soroban
STELLAR_RPC_URL=http://localhost:8000/soroban/rpc
STELLAR_FRIENDBOT_URL=http://localhost:8000/friendbot
STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"

# Database & Cache
DATABASE_URL=postgres://remitsave:remitsave_dev@localhost:5432/remitsave
REDIS_URL=redis://localhost:6379

# Service Authentication & Ports
JWT_SECRET=remitsave-dev-secret-do-not-use-in-prod
AUTH_SERVICE_PORT=3001
REMIT_SERVICE_PORT=3002
GATEWAY_PORT=3000

# Contract IDs (Populated after deploying contracts via scripts/deploy.sh)
REMIT_CONTRACT_ID=
VAULT_CONTRACT_ID=

# Anchor & Fiat Integration
ANCHOR_COWRIE_API_KEY=
ANCHOR_VIBRANT_API_KEY=
CIRCLE_API_KEY=

# Notifications
SMTP_HOST=
SMS_PROVIDER_KEY=

# Mobile App Public URLs
EXPO_PUBLIC_AUTH_API_BASE=http://localhost:3001
EXPO_PUBLIC_REMIT_API_BASE=http://localhost:3002
EXPO_PUBLIC_API_GATEWAY=http://localhost:3000
EXPO_PUBLIC_FRIENDBOT_URL=http://localhost:8000/friendbot
